@page "/"
@inject CodexThreadStore ThreadStore
@inject ICodexTransferPicker TransferPicker

<PageTitle>Codex Thread Browser</PageTitle>

<section class="hero">
    <div>
        <p class="eyebrow">Local Codex Utility</p>
        <h1>Codex Thread Browser</h1>
        <p class="lede">
            Load the current thread index from your local <code>.codex</code> folder, inspect prompt history,
            export a portable snapshot to any folder, then import or restore that snapshot on another machine.
        </p>
    </div>

    <div class="hero-actions">
        <button class="action primary" @onclick="LoadThreadsAsync" disabled="@_isBusy">
            @_loadButtonText
        </button>
        <button class="action secondary" @onclick="ExportSnapshotAsync" disabled="@(_isBusy || _snapshot is null)">
            @_exportButtonText
        </button>
        <button class="action tertiary" @onclick="ImportSnapshotAsync" disabled="@_isBusy">
            @_importButtonText
        </button>
        <button class="action tertiary" @onclick="RestoreImportedSnapshotAsync" disabled="@(_isBusy || !_canRestoreImportedRawFiles)">
            @_restoreButtonText
        </button>
    </div>
</section>

<section class="summary-grid">
    <article class="summary-card">
        <span class="label">Snapshot Mode</span>
        <strong>@_snapshotSourceMode</strong>
    </article>
    <article class="summary-card">
        <span class="label">Snapshot Path</span>
        <strong>@CurrentSnapshotPath</strong>
    </article>
    <article class="summary-card">
        <span class="label">Threads</span>
        <strong>@(_snapshot?.Threads.Count ?? 0)</strong>
    </article>
    <article class="summary-card">
        <span class="label">Parsed Entries</span>
        <strong>@(_snapshot?.ParsedHistoryEntryCount ?? 0)</strong>
    </article>
    <article class="summary-card">
        <span class="label">Last Refresh</span>
        <strong>@FormatMoment(_snapshot?.LoadedAt)</strong>
    </article>
</section>

@if (_canRestoreImportedRawFiles)
{
    <section class="transfer-note">
        <strong>Imported snapshot is ready.</strong>
        This package can be browsed in the app now, and its raw <code>.codex</code> files can be restored into any target folder with the restore button above. Matching files in the chosen folder are overwritten.
    </section>
}

@if (!string.IsNullOrWhiteSpace(_statusMessage))
{
    <p class="status-banner">@_statusMessage</p>
}

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <p class="error-banner">@_errorMessage</p>
}

@if (_snapshot is null)
{
    <section class="empty-state">
        <h2>No snapshot loaded yet</h2>
        <p>Press <strong>Load Threads</strong> to read the current thread list from <code>.codex</code>.</p>
    </section>
}
else
{
    <section class="workspace">
        <div class="thread-list-panel">
            <header class="panel-header">
                <div>
                    <p class="panel-kicker">Thread List</p>
                    <h2>Available Sessions</h2>
                </div>
                <span class="pill">@_snapshot.Threads.Count total</span>
            </header>

            <div class="thread-list">
                @foreach (var thread in _snapshot.Threads)
                {
                    var isSelected = thread.SessionId == _selectedThread?.SessionId;
                    <button class="thread-card @(isSelected ? "selected" : null)"
                            @onclick="() => SelectThread(thread)">
                        <div class="thread-card-header">
                            <strong>@thread.ThreadName</strong>
                            <span>@thread.MessageCount msgs</span>
                        </div>
                        <div class="thread-meta">
                            <span>@ShortId(thread.SessionId)</span>
                            <span>@FormatMoment(thread.LastActivityAt)</span>
                        </div>
                        <p>@thread.Preview</p>
                    </button>
                }
            </div>
        </div>

        <div class="thread-detail-panel">
            @if (_selectedThread is null)
            {
                <div class="empty-state compact">
                    <h2>No thread selected</h2>
                    <p>Select a thread on the left to inspect its prompt history.</p>
                </div>
            }
            else
            {
                <header class="panel-header">
                    <div>
                        <p class="panel-kicker">Thread Detail</p>
                        <h2>@_selectedThread.ThreadName</h2>
                    </div>
                    <span class="pill">@_selectedThread.MessageCount messages</span>
                </header>

                <div class="detail-summary">
                    <div>
                        <span class="label">Session Id</span>
                        <strong>@_selectedThread.SessionId</strong>
                    </div>
                    <div>
                        <span class="label">Indexed Update</span>
                        <strong>@FormatMoment(_selectedThread.IndexedUpdatedAt)</strong>
                    </div>
                    <div>
                        <span class="label">First Message</span>
                        <strong>@FormatMoment(_selectedThread.FirstMessageAt)</strong>
                    </div>
                    <div>
                        <span class="label">Last Message</span>
                        <strong>@FormatMoment(_selectedThread.LastMessageAt)</strong>
                    </div>
                </div>

                <div class="message-list">
                    @if (_selectedThread.Messages.Count == 0)
                    {
                        <div class="empty-state compact">
                            <h2>No prompt history</h2>
                            <p>This thread is indexed locally, but no matching entries were found in <code>history.jsonl</code>.</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var message in _selectedThread.Messages)
                        {
                            <article class="message-card @(message.IsAssistant ? "assistant" : "user")">
                                <header>
                                    <span>@message.DisplayRole</span>
                                    <span>@message.UtcTimestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</span>
                                    <span>@message.UnixTimestamp</span>
                                </header>
                                <pre>@message.Text</pre>
                            </article>
                        }
                    }
                </div>
            }
        </div>
    </section>
}

@code {
    private readonly string _defaultCodexHome = Path.Combine(
        Environment.GetFolderPath(Environment.SpecialFolder.UserProfile),
        ".codex");

    private CodexThreadSnapshot? _snapshot;
    private CodexThreadItem? _selectedThread;
    private bool _isLoading;
    private bool _isExporting;
    private bool _isImporting;
    private bool _isRestoring;
    private string? _statusMessage;
    private string? _errorMessage;
    private string _snapshotSourceMode = "Local .codex";
    private string? _snapshotSourcePath;
    private string? _importedPackageRoot;

    private bool _isBusy => _isLoading || _isExporting || _isImporting || _isRestoring;

    private bool _canRestoreImportedRawFiles => !string.IsNullOrWhiteSpace(_importedPackageRoot);

    private string CurrentSnapshotPath => _snapshotSourcePath ?? _defaultCodexHome;

    private string _loadButtonText => _isLoading ? "Loading..." : "Load Local Threads";

    private string _exportButtonText => _isExporting ? "Exporting..." : "Export Snapshot...";

    private string _importButtonText => _isImporting ? "Importing..." : "Import Snapshot...";

    private string _restoreButtonText => _isRestoring ? "Restoring..." : "Restore Imported Raw Files...";

    private async Task LoadThreadsAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        _statusMessage = "Reading current thread metadata from .codex...";

        try
        {
            var snapshot = await ThreadStore.LoadSnapshotAsync();
            ApplySnapshot(snapshot, "Local .codex", snapshot.CodexHome);
            _statusMessage = $"Loaded {snapshot.Threads.Count} threads from {snapshot.CodexHome}.";
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
            _statusMessage = null;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ExportSnapshotAsync()
    {
        if (_snapshot is null)
        {
            return;
        }

        _isExporting = true;
        _errorMessage = null;
        _statusMessage = "Choose a destination folder for the exported snapshot...";

        try
        {
            var exportDirectory = await TransferPicker.PickExportDestinationDirectoryAsync();
            if (string.IsNullOrWhiteSpace(exportDirectory))
            {
                _statusMessage = "Export canceled.";
                return;
            }

            _statusMessage = $"Writing a portable snapshot under {exportDirectory}...";
            var result = await ThreadStore.ExportSnapshotAsync(_snapshot, exportDirectory);
            _statusMessage = $"Exported {result.ThreadCount} threads to {result.OutputDirectory}.";
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
            _statusMessage = null;
        }
        finally
        {
            _isExporting = false;
        }
    }

    private async Task ImportSnapshotAsync()
    {
        _isImporting = true;
        _errorMessage = null;
        _statusMessage = "Choose an exported manifest.json file to import...";

        try
        {
            var manifestPath = await TransferPicker.PickImportManifestFileAsync();
            if (string.IsNullOrWhiteSpace(manifestPath))
            {
                _statusMessage = "Import canceled.";
                return;
            }

            _statusMessage = $"Loading exported snapshot from {manifestPath}...";
            var imported = await ThreadStore.LoadExportedSnapshotAsync(manifestPath);
            ApplySnapshot(imported.Snapshot, "Imported snapshot", imported.PackageRoot, imported.PackageRoot);
            _statusMessage = $"Loaded {imported.Snapshot.Threads.Count} threads from {imported.PackageRoot}. Use restore if you want to copy the raw files into another .codex folder.";
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
            _statusMessage = null;
        }
        finally
        {
            _isImporting = false;
        }
    }

    private async Task RestoreImportedSnapshotAsync()
    {
        if (string.IsNullOrWhiteSpace(_importedPackageRoot))
        {
            return;
        }

        _isRestoring = true;
        _errorMessage = null;
        _statusMessage = "Choose the target .codex folder to receive the imported raw files. Matching files will be overwritten...";

        try
        {
            var destinationDirectory = await TransferPicker.PickRestoreDestinationDirectoryAsync();
            if (string.IsNullOrWhiteSpace(destinationDirectory))
            {
                _statusMessage = "Restore canceled.";
                return;
            }

            _statusMessage = $"Copying raw snapshot files into {destinationDirectory}...";
            var result = await ThreadStore.RestoreExportAsync(_importedPackageRoot, destinationDirectory);
            _statusMessage = $"Restored {result.CopiedFileCount} files into {result.DestinationDirectory}.";
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
            _statusMessage = null;
        }
        finally
        {
            _isRestoring = false;
        }
    }

    private void SelectThread(CodexThreadItem thread)
    {
        _selectedThread = thread;
    }

    private void ApplySnapshot(CodexThreadSnapshot snapshot, string sourceMode, string sourcePath, string? importedPackageRoot = null)
    {
        _snapshot = snapshot;
        _selectedThread = snapshot.Threads.FirstOrDefault();
        _snapshotSourceMode = sourceMode;
        _snapshotSourcePath = sourcePath;
        _importedPackageRoot = importedPackageRoot;
    }

    private static string ShortId(string sessionId)
    {
        return sessionId.Length <= 12
            ? sessionId
            : $"{sessionId[..8]}...{sessionId[^4..]}";
    }

    private static string FormatMoment(DateTimeOffset? value)
    {
        return value?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") ?? "n/a";
    }
}
